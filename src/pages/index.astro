---
import Layout from "../layouts/Layout.astro";
import LineHeader from "../components/LineHeader.astro";
import HeaderButton from "../components/HeaderButton.astro";
import NetworkStatus from "../components/NetworkStatus.astro";
import LineChip from "../components/LineChip.astro";
import type { Route } from "../services/gcba.service";
import Loader2Icon from "../icons/Loader2.astro";

var title: string = "Subte de Buenos Aires";

export const prerender = false;

var routes: Route[] = [
  {
    ids: ["LineaA"],
    name: "Línea A",
    letter: "A",
    href: "/a",
    alerts: [],
  },
  {
    ids: ["LineaB"],
    name: "Línea B",
    letter: "B",
    href: "/b",
    alerts: [],
  },
  {
    ids: ["LineaC"],
    name: "Línea C",
    letter: "C",
    href: "/c",
    alerts: [],
  },
  {
    ids: ["LineaD"],
    name: "Línea D",
    letter: "D",
    href: "/d",
    alerts: [],
  },
  {
    ids: ["LineaE"],
    name: "Línea E",
    letter: "E",
    href: "/e",
    alerts: [],
  },
  {
    ids: ["LineaH"],
    name: "Línea H",
    letter: "H",
    href: "/h",
    alerts: [],
  },
  {
    ids: ["PM-Civico", "PM-Savio"],
    name: "Premetro",
    letter: "P",
    href: "/premetro",
    alerts: [],
  },
];
---

<Layout title={title} description="">
  <div class="flex flex-col min-h-svh h-max w-full justify-center">
    <div
      class="flex flex-col bg-gray-300/90 min-h-dvh border-b-2 border-gray-950/5 w-full"
    >
      <LineHeader
        name="Subte de Buenos Aires"
        description="por Cristian Leguizamón"
        color="bg-zinc-800"
        buttons={[<HeaderButton title="Acerca de" href="/about" />]}
      />
      <div
        class="flex flex-col gap-1 max-w-3xl w-full p-3 md:min-h-[calc(100svh-47.7501px)] self-center"
      >
        <div class="flex gap-3 not-md:flex-col">
          <NetworkStatus server:defer>
            <div slot="fallback" class="flex flex-col gap-2 bg-zinc-100 md:max-w-1/2 w-[stretch] rounded-sm pb-2">
              <h5 class="flex gap-2 items-center px-3 py-2 pb-0">
                <span>Estado de la red</span><p class="">
                  <Loader2Icon class="size-5 animate-spin" />
                </p>
              </h5>
              <div class="flex flex-col gap-1">
                {
                  routes.map((route) => {
                    return (
                      <a href={route.href} class="flex items-stretch gap-0 border-0">
                        <div class="flex items-stretch gap-1 w-fit">
                          <div
                            class="flex gap-1 min-w-24 items-center h-[stretch] bg-zinc-300 pl-3 px-2 py-1"
                          >
                            <LineChip line=`${route.letter}` />
                            <p class="text-xs">{route.name}</p>
                          </div>
                        </div>
                        <div class="w-full bg-zinc-50">
                          <div class="relative h-full flex-1 overflow-hidden bg-zinc-50">
                            <div
                              class="absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-zinc-300 to-transparent animate-shimmer"
                            />
                          </div>
                        </div>
                      </a>
                    );
                  })
                }
              </div>
            </div>
          </NetworkStatus>
          
        </div>
