---
import Layout from "../layouts/Layout.astro";
import LineChip from "../components/LineChip.astro";
import LineHeader from "../components/LineHeader.astro";
import HeaderButton from "../components/HeaderButton.astro";
import type { Station } from "../services/gcba.service";
import EstimatedTime from "../components/EstimatedTime.tsx";
import Loader2Icon from "../icons/Loader2.astro";

var title: string = "Línea C - Subte de Buenos Aires";

const stations: Station[] = [
  {
    ids: ["1094E", "1094O"],
    name: "Constitución",
    line_combinations: [],
  },
  {
    ids: ["1095E", "1095O"],
    name: "San Juan",
    line_combinations: [],
  },
  {
    ids: ["1096E", "1096O"],
    name: "Independencia",
    line_combinations: ["e"],
  },
  {
    ids: ["1097E", "1097O"],
    name: "Moreno",
    line_combinations: [],
  },
  {
    ids: ["1098E", "1098O"],
    name: "Av. de Mayo",
    line_combinations: ["a"],
  },
  {
    ids: ["1099E", "1099O"],
    name: "Diagonal Norte",
    line_combinations: ["b", "d"],
  },
  {
    ids: ["1100E", "1100O"],
    name: "Lavalle",
    line_combinations: [],
  },
  {
    ids: ["1101E", "1101O"],
    name: "General San Martín",
    line_combinations: [],
  },
  {
    ids: ["1102E", "1102O"],
    name: "Retiro",
    line_combinations: ["e"],
  },
];
---

<Layout title={title} description="">
  <div class="flex flex-col min-h-svh h-max w-full justify-center">
    <div
      class="flex flex-col bg-gray-300/90 min-h-dvh border-b-2 border-gray-950/5 w-full"
    >
      <LineHeader
        name="Línea C"
        description="Constitución / Retiro"
        color="bg-line-c"
        buttons={(<HeaderButton title="Volver" href="/" />)}
      />
      <div
        class="flex flex-col gap-1 max-w-3xl w-full p-3 md:min-h-[calc(100svh-47.7501px)] self-center"
      >
        <div class="flex gap-3 not-md:flex-col">
          <EstimatedTime
            server:defer
            client:load
            stations={stations}
            routeId="LineaC"
            firstStation="Retiro"
            lastStation="Constitución"
          >
            <div
              slot="fallback"
              class="flex flex-col gap-2 bg-zinc-100 w-[stretch] rounded-sm pb-2"
            >
              <div class="flex justify-between items-center px-3 py-2 pb-0">
                <h5>Horarios estimados</h5>
                <p class="">
                  <Loader2Icon class="size-5 animate-spin" />
                </p>
              </div>
              <div class="flex flex-col gap-1">
                <div
                  class="flex not-md:flex-col items-stretch gap-0 -mb-1 bg-zinc-800 text-zinc-50"
                >
                  <div class="flex md:flex-1/2 gap-1">
                    <div
                      class={"flex gap-1 min-w-24 w-full items-center pl-3 px-2 py-1"}
                    >
                      <p style="text-xs">Estación</p>
                    </div>
                  </div>
                  <div class="flex md:flex-1/2 gap-0">
                    <div
                      class="flex md:flex-1/12 justify-center gap-1 flex-wrap w-full items-center h-[stretch] not-md:pr-1 py-1"
                    >
                      <p class="text-xs text-pretty">a Retiro</p>
                    </div>
                    <div
                      class="flex md:flex-1/12 justify-center gap-1 flex-wrap w-full items-center h-[stretch] not-md:pr-2 pr-1 py-1"
                    >
                      <p class="text-xs text-pretty">a Constitución</p>
                    </div>
                  </div>
                </div>
                {
                  stations.map((station) => {
                    return (
                      <div class="flex not-md:flex-col items-stretch gap-0">
                        <div class="flex md:flex-1/2 gap-1">
                          <div
                            class={
                              "flex gap-1 min-w-24 w-full items-center bg-zinc-300 pl-3 px-2 py-1"
                            }
                          >
                            <p style="text-xs">{station.name}</p>
                            {station.line_combinations.length !== 0
                              ? station.line_combinations.map((combination) => (
                                  <LineChip line={combination} />
                                ))
                              : null}
                          </div>
                        </div>
                        <div class="flex md:flex-1/2 gap-0">
                          <div class="w-full bg-zinc-50">
                            <div class="relative h-full not-md:min-h-[26.97px] flex-1 overflow-hidden bg-zinc-50">
                              <div class="absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-zinc-300 to-transparent animate-shimmer" />
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </EstimatedTime>
        </div>

        <!-- <div class="flex gap-1 flex-col max-w-1/2">
          {
            stations.map((station) => {
              return (
                <div class="flex gap-1 bg-gray-100 rounded-sm px-2 py-1 w-fit text-sm items-center">
                  {station.line_combinations.length !== 0
                    ? station.line_combinations.map((combination) => (
                        <LineChip line={combination} />
                      ))
                    : null}
                  <p>{station.name}</p>
                </div>
              );
            })
          }
        </div> -->
      </div>
    </div>
  </div>
</Layout>
