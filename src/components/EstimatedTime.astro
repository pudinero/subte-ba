---
import type {
  CurrentStation,
  RealtimeInfo,
  Station,
} from "../services/gcba.service";
import { gtfsService, type RawForecastData } from "../services/gtfs.service";
import { getEstadoTren } from "../utils/tiempo";
import LineChip from "./LineChip.astro";

interface Props {
  stations: Station[];
  routeId: string;
  firstStation: string;
  lastStation: string;
}

export const prerender = false;

const { stations, routeId, firstStation, lastStation } = Astro.props;

const lastForecastData: RawForecastData | undefined =
  gtfsService.getForecastsById(routeId);

let actualPositions: { ID: string; Linea: RealtimeInfo }[] | undefined =
  lastForecastData?.Entity;
let directionOne: CurrentStation[] = [];
let directionZero: CurrentStation[] = [];

if (actualPositions) {
  actualPositions.forEach((pos) => {
    if (pos.Linea.Direction_ID === 0) {
      directionZero.push(...pos.Linea.Estaciones);
    } else {
      directionOne.push(...pos.Linea.Estaciones);
    }
  });
}

const initConfig = {
  routeId,
  stations,
  initialForecast: lastForecastData,
};
---

<estimated-time-island
  class="flex flex-col gap-2 bg-zinc-100 w-[stretch] rounded-sm pb-2"
  data-route-id={routeId}
>
  <script type="application/json" class="et-config" set:html={JSON.stringify(initConfig)} />
  <div class="flex justify-between items-center px-3 py-2 pb-0">
    <h5>Horarios estimados</h5>
    <p class="text-sm font-light text-end" data-last-update>
      {
        lastForecastData?.Header?.timestamp ? (
          `Últ. actualización: ${new Date(lastForecastData.Header.timestamp * 1000).toLocaleTimeString()}`
        ) : ("")
      }
    </p>
  </div>
  <div class="flex flex-col gap-1">
    <div
      class="flex not-md:flex-col items-stretch gap-0 -mb-1 bg-zinc-800 text-zinc-50"
    >
      <div class="flex md:flex-1/2 gap-1">
        <div class={"flex gap-1 min-w-24 w-full items-center pl-3 px-2 py-1"}>
          <p style="text-xs">Estación</p>
        </div>
      </div>
      <div class="flex md:flex-1/2 gap-0">
        <div
          class="flex md:flex-1/12 justify-center gap-1 flex-wrap w-full items-center h-[stretch] not-md:pr-1 py-1"
        >
          <p class="text-xs text-pretty">a {firstStation}</p>
        </div>
        <div
          class="flex md:flex-1/12 justify-center gap-1 flex-wrap w-full items-center h-[stretch] not-md:pr-2 pr-1 py-1"
        >
          <p class="text-xs text-pretty">a {lastStation}</p>
        </div>
      </div>
    </div>
    {
      stations.map((station) => {
        return (
          <div class="flex not-md:flex-col items-stretch gap-0">
            <div class="flex md:flex-1/2 gap-1">
              <div
                class={
                  "flex gap-1 min-w-24 w-full items-center bg-zinc-300 pl-3 px-2 py-1"
                }
              >
                <p style="text-xs">{station.name}</p>
                {station.line_combinations.length !== 0
                  ? station.line_combinations.map((combination) => (
                      <LineChip line={combination} />
                    ))
                  : null}
              </div>
            </div>
            <div class="flex md:flex-1/2 gap-0">
              <div
                class="flex md:flex-1/12 not-md:w-full justify-center gap-1 flex-wrap w-full items-center h-[stretch] px-2 py-1"
                data-station-cell="1"
                data-station-ids={JSON.stringify(station.ids)}
              >
                {(() => {
                  if (directionOne.length === 0) {
                    return <p class="text-xs">Sin horarios</p>;
                  }
                  const hasStopInDirection = directionOne.some((dir) =>
                    station.ids.includes(dir.stop_id),
                  );
                  if (!hasStopInDirection) {
                    return null;
                  }
                  const estado = getEstadoTren(
                    station.ids,
                    directionOne,
                    "arrival",
                  );
                  if (!estado) return null;

                  return (
                    <>
                      <p
                        class={`text-xs text-pretty font-bold ${
                          estado.tiempoTexto === "En andén"
                            ? "text-green-600"
                            : estado.tiempoTexto === "Ingresando"
                              ? "text-amber-500"
                              : ""
                        }`}
                      >
                        {estado.tiempoTexto}
                      </p>

                      {(estado.atrasado && estado.minutosDeRetraso >= 5) && (
                        <span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-medium width-fit">
                          +${estado.minutosDeRetraso} min
                        </span>
                      )}
                    </>
                  );
                })()}
              </div>

              <div
                class="flex md:flex-1/12 not-md:w-full flex-wrap justify-center gap-1 w-full items-center h-[stretch] pr-3 px-2 py-1"
                data-station-cell="0"
                data-station-ids={JSON.stringify(station.ids)}
              >
                {(() => {
                  if (directionZero.length === 0) {
                    return <p class="text-xs">Sin horarios</p>;
                  }
                  const hasStopInDirection = directionZero.some((dir) =>
                    station.ids.includes(dir.stop_id),
                  );
                  if (!hasStopInDirection) {
                    return null;
                  }
                  const estado = getEstadoTren(
                    station.ids,
                    directionZero,
                    "arrival",
                  );
                  if (!estado) return null;

                  return (
                    <>
                      <p
                        class={`text-xs text-pretty font-bold ${
                          estado.tiempoTexto === "En andén"
                            ? "text-green-600"
                            : estado.tiempoTexto === "Ingresando"
                              ? "text-amber-500"
                              : ""
                        }`}
                      >
                        {estado.tiempoTexto}
                      </p>

                      {(estado.atrasado && estado.minutosDeRetraso >= 5) && (
                        <span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-medium width-fit">
                          +${estado.minutosDeRetraso} min
                        </span>
                      )}
                    </>
                  );
                })()}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</estimated-time-island>

<script>
  import { getEstadoTren } from "../utils/tiempo";
  import type { CurrentStation } from "../services/gcba.service";
  import type { RawForecastData } from "../services/gtfs.service";

  class EstimatedTimeIsland extends HTMLElement {
    private countdownInterval: number | null = null;
    private pollInterval: number | null = null;
    private currentForecast: RawForecastData | undefined;
    private routeId: string = "";
    private boundHandleVisibility = this.handleVisibility.bind(this);

    connectedCallback() {
      const configEl = this.querySelector<HTMLScriptElement>(".et-config");
      if (!configEl) return;

      try {
        const config = JSON.parse(configEl.textContent || "{}");
        this.routeId = config.routeId || this.dataset.routeId || "";
        this.currentForecast = config.initialForecast;
      } catch (err) {
        console.error("Error parsing et-config JSON:", err);
        return;
      }

      this.render();

      if (!this.currentForecast) {
        this.fetchForecast();
      }

      // 1s countdown tick
      this.countdownInterval = window.setInterval(() => {
        if (!document.hidden && this.currentForecast) {
          this.render();
        }
      }, 1000);

      // 30s background poll
      this.pollInterval = window.setInterval(() => {
        if (!document.hidden) {
          this.fetchForecast();
        }
      }, 30000);

      document.addEventListener("visibilitychange", this.boundHandleVisibility);
    }

    disconnectedCallback() {
      if (this.countdownInterval !== null) {
        clearInterval(this.countdownInterval);
        this.countdownInterval = null;
      }
      if (this.pollInterval !== null) {
        clearInterval(this.pollInterval);
        this.pollInterval = null;
      }
      document.removeEventListener("visibilitychange", this.boundHandleVisibility);
    }

    private handleVisibility() {
      if (!document.hidden) {
        this.fetchForecast();
        this.render();
      }
    }

    private async fetchForecast() {
      if (!this.routeId) return;
      try {
        const res = await fetch(`/api/forecast/${this.routeId}.json`);
        if (res.status === 200) {
          this.currentForecast = (await res.json()) as RawForecastData;
          this.render();
        } else if (res.status === 204) {
          this.currentForecast = undefined;
          this.render();
        }
      } catch (err) {
        console.error(`Error polling forecast for ${this.routeId}:`, err);
      }
    }

    private render() {
      const lastUpdateEl = this.querySelector<HTMLElement>("[data-last-update]");
      if (lastUpdateEl) {
        if (this.currentForecast?.Header?.timestamp) {
          lastUpdateEl.textContent = `Últ. actualización: ${new Date(
            this.currentForecast.Header.timestamp * 1000,
          ).toLocaleTimeString()}`;
        } else {
          lastUpdateEl.textContent = "";
        }
      }

      const dir0: CurrentStation[] = [];
      const dir1: CurrentStation[] = [];

      if (this.currentForecast?.Entity) {
        this.currentForecast.Entity.forEach((pos) => {
          if (pos.Linea.Direction_ID === 0) {
            dir0.push(...pos.Linea.Estaciones);
          } else {
            dir1.push(...pos.Linea.Estaciones);
          }
        });
      }

      const cells = this.querySelectorAll<HTMLElement>("[data-station-cell]");
      cells.forEach((cell) => {
        const dirType = cell.dataset.stationCell;
        const idsJson = cell.dataset.stationIds;
        if (!idsJson) return;

        let stationIds: string[] = [];
        try {
          stationIds = JSON.parse(idsJson);
        } catch {
          return;
        }

        const targetDirection = dirType === "1" ? dir1 : dir0;
        if (targetDirection.length === 0) {
          cell.innerHTML = '<p class="text-xs">Sin horarios</p>';
          return;
        }

        const hasStopInDirection = targetDirection.some((dir) =>
          stationIds.includes(dir.stop_id),
        );

        if (!hasStopInDirection) {
          cell.innerHTML = "";
          return;
        }

        const estado = getEstadoTren(stationIds, targetDirection, "arrival");
        if (!estado) {
          cell.innerHTML = "";
          return;
        }

        const colorClass =
          estado.tiempoTexto === "En andén"
            ? "text-green-600"
            : estado.tiempoTexto === "Ingresando"
              ? "text-amber-500"
              : "";

        let html = `<p class="text-xs text-pretty font-bold ${colorClass}">${estado.tiempoTexto}</p>`;
        if (estado.atrasado && estado.minutosDeRetraso >= 5) {
          html += `<span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-medium width-fit">+${estado.minutosDeRetraso} min</span>`;
        }

        cell.innerHTML = html;
      });
    }
  }

  if (!customElements.get("estimated-time-island")) {
    customElements.define("estimated-time-island", EstimatedTimeIsland);
  }
</script>
